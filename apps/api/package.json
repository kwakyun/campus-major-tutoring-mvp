    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/node": "20.16.11",
    "@types/supertest": "6.0.2",
    "eslint": "8.57.1",
    "supertest": "7.0.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
