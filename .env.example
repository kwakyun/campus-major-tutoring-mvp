# 전공한시간 — 환경변수 예시 (S03-T01)
# 실제 값은 절대 커밋하지 않는다. local/demo-staging/production을 별도 .env 파일로 분리한다.
# 외부 자격증명(Supabase, 결제 제공자 등)은 아직 확보되지 않았다 — 아래 값은 형태만 예시이며
# 실제 키를 만들어내지 않는다(00-workflow.yaml 공통 지침).

# --- 공통 ---
NODE_ENV=development
APP_ENV=local            # local | demo | staging | production
PAYMENT_MODE=fake        # fake | test | live — 서버 설정, 클라이언트가 바꿀 수 없음(아키텍처 §11)

# --- DB (PostgreSQL, 초기 로컬은 docker-compose 또는 로컬 설치로 대체) ---
DATABASE_URL=postgres://localhost:5432/campus_major_tutoring_dev
# 운영/스테이징 DB는 별도 URL을 CI/배포 시크릿으로 주입한다. 여기 값으로 대체하지 않는다.

# --- 인증(Supabase Auth 후보 — 계약 미체결, 로컬은 세션 쿠키 기반 테스트 대역 사용) ---
SUPABASE_URL=            # 미확보 — 확보 전까지 apps/api는 로컬 세션 가드로 대체 동작
SUPABASE_ANON_KEY=       # 미확보
SUPABASE_SERVICE_ROLE_KEY=  # 미확보 — 브라우저에 절대 노출 금지(웹서비스 아키텍처 §10)

# --- 세션 쿠키(로컬 개발용) ---
SESSION_COOKIE_SECRET=change-me-in-each-environment

# --- 결제 제공자(토스페이먼츠 후보 — 계약 미체결) ---
PAYMENTS_PROVIDER_API_KEY=   # 미확보. PAYMENT_MODE=fake인 동안 사용하지 않음

# --- AI 커리큘럼 초안 생성(에드혹 추가 — docs/handoffs/ADHOC-01-ai-curriculum-draft.md) ---
# 실제 LLM/임베딩 제공자 계약 미체결. 현재 CurriculumDraftService는 이 키를 전혀 참조하지
# 않으며 규칙 기반 임시 생성기로만 동작한다. 실제 연동 시점에 값과 참조 코드를 함께 추가한다.
AI_CURRICULUM_PROVIDER_API_KEY=   # 미확보 — 현재 미사용(규칙 기반 생성기로 대체 중)

# --- API 기본 URL(웹 → 업무 서버) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- CORS(apps/api) — 쉼표로 구분한 허용 오리진 목록. 운영 도메인은 아직 미확정 ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
